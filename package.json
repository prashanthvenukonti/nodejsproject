{
  "name": "devops-node-app",
  "version": "1.0.0",
  "description": "A beautiful Node.js app for practicing CI/CD: GitHub Actions -> SonarCloud -> Docker -> AWS ECR -> EKS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "validate": "npm run lint",
    "lint": "eslint .",
    "build": "node scripts/build.js",
    "test": "jest --coverage",
    "package": "npm pack --pack-destination dist"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "public",
    "dist/build-info.json"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
